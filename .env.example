# Copie para .env e ajuste se necessário (o docker compose lê este arquivo automaticamente)
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=kindle
# Para execução local (fora do Docker)
MONGO_URI=mongodb://admin:admin123@localhost:27017/?authSource=admin
SPARK_DRIVER_MEMORY=2g
AUTHOR_MIN_REVIEWS=1000
# Credenciais do Kaggle (https://www.kaggle.com/settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=
